@model List<Medinova.DTOs.ResultTestimonialDto>

@{
    ViewBag.Title = "Referanslar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-xl bg-cyan-50 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-3xl">reviews</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Hasta Yorumları</h1>
                <p class="text-slate-500 text-sm font-medium">Web sitesinde yayınlanan hasta referanslarını yönetin.</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("Create", "AdminTestimonial")" class="relative group overflow-hidden px-8 py-3 rounded-xl bg-gradient-to-r from-primary to-cyan-500 text-white font-bold shadow-lg shadow-cyan-500/30 hover:shadow-cyan-500/50 transition-all duration-300 transform hover:-translate-y-0.5">
                <span class="absolute inset-0 w-full h-full bg-white/20 group-hover:translate-x-full transition-transform duration-500 ease-out -skew-x-12 origin-left"></span>
                <div class="relative flex items-center gap-2">
                    <span class="material-symbols-outlined">add_comment</span>
                    <span>Yeni Yorum</span>
                </div>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/40 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100">
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-24">Profil</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-1/4">Ad Soyad & Meslek</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Yorum</th>
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest text-right w-40">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="group hover:bg-cyan-50/40 transition-all duration-300">

                                <td class="px-8 py-6 align-top">
                                    <div class="h-14 w-14 rounded-full border-2 border-white shadow-md overflow-hidden bg-slate-100 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="h-full w-full object-cover" alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 font-bold text-lg">@item.Name.Substring(0, 1)</span>
                                        }
                                    </div>
                                </td>

                                <td class="px-6 py-6 align-top">
                                    <div class="flex flex-col">
                                        <span class="text-base font-bold text-slate-700 group-hover:text-primary transition-colors">
                                            @item.Name
                                        </span>
                                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide mt-1">
                                            @item.Profession
                                        </span>
                                    </div>
                                </td>

                                <td class="px-6 py-6 align-top">
                                    <div class="relative pl-6">
                                        <span class="absolute left-0 top-0 text-cyan-200 text-4xl leading-none font-serif select-none">"</span>
                                        <p class="text-sm text-slate-500 leading-relaxed font-medium whitespace-normal break-words text-justify pr-4">
                                            @item.Description
                                        </p>
                                    </div>
                                </td>

                                <td class="px-8 py-6 align-top text-right">
                                    <div class="flex items-center justify-end gap-3 opacity-80 group-hover:opacity-100 transition-opacity">
                                        <a href="@Url.Action("Update", "AdminTestimonial", new { id = item.TestimonialID })"
                                           class="h-10 w-10 rounded-xl bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-primary hover:text-white hover:border-primary shadow-sm hover:shadow-primary/30 transition-all duration-200">
                                            <span class="material-symbols-outlined text-[20px]">edit_square</span>
                                        </a>
                                        <a href="javascript:void(0);"
                                           data-url="@Url.Action("Delete", "AdminTestimonial", new { id = item.TestimonialID })"
                                           class="btn-sil h-10 w-10 rounded-xl bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-red-500 hover:text-white hover:border-red-500 shadow-sm hover:shadow-red-500/30 transition-all duration-200">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-16 text-center text-slate-400 font-medium">Henüz yorum eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
