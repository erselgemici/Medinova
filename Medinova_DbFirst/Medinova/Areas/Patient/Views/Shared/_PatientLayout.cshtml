@{
    string userName = Session["UserInfo"] as string ?? "Değerli Hastamız";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hasta Paneli</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>
<body>

    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">

                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 bg-[#13b6ec] rounded-xl flex items-center justify-center text-white shadow-lg shadow-cyan-500/20">
                        <span class="material-symbols-outlined">medical_services</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-black text-slate-800 tracking-tight">Medinova</h1>
                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Hasta Portalı</p>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <a href="/Patient/Profile/Edit" class="hidden md:flex flex-col items-end mr-2 hover:opacity-80 transition-opacity">
                        <p class="text-sm font-bold text-slate-700">@userName</p>
                        <p class="text-[10px] text-[#13b6ec] font-bold uppercase flex items-center gap-1">
                            <span class="material-symbols-outlined text-[12px]">settings</span> Ayarları Düzenle
                        </p>
                    </a>

                    <a href="/Login/Logout" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-red-50 text-red-500 font-bold text-sm hover:bg-red-500 hover:text-white transition-all duration-300 group">
                        <span class="material-symbols-outlined text-[18px]">logout</span>
                        <span class="hidden sm:inline">Güvenli Çıkış</span>
                    </a>
                </div>

            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Sayfadaki "btn-iptal" sınıfına sahip linklere tıklandığında çalışır
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.btn-iptal');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const url = this.getAttribute('href');
                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Randevunuz iptal edilecek, bu işlem geri alınamaz!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#94a3b8',
                        confirmButtonText: 'Evet, İptal Et',
                        cancelButtonText: 'Vazgeç',
                        background: '#fff',
                        borderRadius: '1rem'
                    }).then((result) => {
                        if (result.isConfirmed) window.location.href = url;
                    });
                });
            });
        });
    </script>

</body>
</html>
