@model List<Medinova.DTOs.DoctorDtos.ResultDoctorDto>

@{
    ViewBag.Title = "Doktor Listesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-xl bg-cyan-50 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-3xl">stethoscope</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Doktor Yönetimi</h1>
                <p class="text-slate-500 text-sm font-medium">Hastanemizdeki uzman hekim kadrosu.</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="relative hidden md:block group">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary material-symbols-outlined text-[20px] transition-colors">search</span>
                <input type="text" placeholder="Doktor ara..." class="pl-10 pr-4 py-3 bg-slate-50 border-none rounded-xl text-sm font-bold text-slate-600 focus:ring-2 focus:ring-primary/30 focus:bg-white transition-all w-64 placeholder:text-gray-400">
            </div>

            <a href="@Url.Action("Create", "AdminDoctor")" class="relative group overflow-hidden px-8 py-3 rounded-xl bg-gradient-to-r from-primary to-cyan-500 text-white font-bold shadow-lg shadow-cyan-500/30 hover:shadow-cyan-500/50 transition-all duration-300 transform hover:-translate-y-0.5">
                <span class="absolute inset-0 w-full h-full bg-white/20 group-hover:translate-x-full transition-transform duration-500 ease-out -skew-x-12 origin-left"></span>
                <div class="relative flex items-center gap-2">
                    <span class="material-symbols-outlined">person_add</span>
                    <span>Yeni Doktor</span>
                </div>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/40 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100">
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-24">Profil</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Ad Soyad & Unvan</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Uzmanlık Alanı</th>
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest text-right">Yönetim</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var doctor in Model)
                        {
                            <tr class="group hover:bg-cyan-50/40 transition-all duration-300">

                                <td class="px-8 py-5">
                                    <div class="h-12 w-12 rounded-full border-2 border-white shadow-md overflow-hidden bg-slate-100 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                        @if (!string.IsNullOrEmpty(doctor.ImageUrl))
                                        {
                                            <img src="@doctor.ImageUrl" class="h-full w-full object-cover" alt="@doctor.FullName" />
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 font-bold text-lg">@doctor.FullName.Substring(0, 1)</span>
                                        }
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-bold text-slate-700 group-hover:text-primary transition-colors">
                                            @doctor.FullName
                                        </span>
                                        <span class="text-[10px] text-slate-400 font-medium">Hekim ID: #@doctor.DoctorID</span>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 text-xs font-bold">
                                        <span class="material-symbols-outlined text-[16px]">ward</span>
                                        @doctor.DepartmentName
                                    </span>
                                </td>

                                <td class="px-8 py-5 text-right">
                                    <div class="flex items-center justify-end gap-3 opacity-80 group-hover:opacity-100 transition-opacity">
                                        <a href="@Url.Action("Update", "AdminDoctor", new { id = doctor.DoctorID })"
                                           class="h-9 w-9 rounded-lg bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-primary hover:text-white hover:border-primary shadow-sm hover:shadow-primary/30 transition-all duration-200" title="Düzenle">
                                            <span class="material-symbols-outlined text-[18px]">edit_square</span>
                                        </a>

                                        <a href="javascript:void(0);"
                                           data-url="@Url.Action("Delete", "AdminDoctor", new { id = doctor.DoctorID })"
                                           class="btn-sil h-9 w-9 rounded-lg bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-red-500 hover:text-white hover:border-red-500 shadow-sm hover:shadow-red-500/30 transition-all duration-200" title="Sil">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-16 text-center bg-slate-50/30">
                                <div class="flex flex-col items-center justify-center gap-4">
                                    <div class="h-16 w-16 bg-white rounded-full shadow-sm flex items-center justify-center">
                                        <span class="material-symbols-outlined text-4xl text-gray-300">person_off</span>
                                    </div>
                                    <h3 class="text-lg font-bold text-slate-700">Kayıtlı Doktor Yok</h3>
                                    <a href="@Url.Action("Create", "AdminDoctor")" class="text-primary font-bold text-sm hover:underline">+ Yeni Doktor Ekle</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
