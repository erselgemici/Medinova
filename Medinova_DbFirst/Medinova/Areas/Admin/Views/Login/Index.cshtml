@model Medinova.DTOs.AccountDtos.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Medinova | Yönetim Paneli Girişi</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/Content/admin-login.css" rel="stylesheet" />
</head>
<body>

    <div class="login-card">
        <div class="brand-logo">
            <i class="fas fa-heartbeat"></i> MEDİNOVA
        </div>
        <p class="brand-subtitle">Hastane Yönetim Paneli</p>

        @using (Html.BeginForm("Index", "Login", FormMethod.Post))
        {
            <div class="mb-3 text-start">
                <label class="form-label text-muted small">E-Posta Adresi</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fas fa-envelope text-muted"></i></span>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-0 bg-light", placeholder = "mail@medinova.com" })
                </div>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger ms-1" })
            </div>

            <div class="mb-3 text-start">
                <label class="form-label text-muted small">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fas fa-lock text-muted"></i></span>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control border-0 bg-light", placeholder = "••••••••" })
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger ms-1" })
            </div>

            if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn btn-medinova">
                Güvenli Giriş Yap
            </button>

            <p class="mt-4 mb-0 text-muted small">
                &copy; @DateTime.Now.Year Medinova Hospital
            </p>
        }
    </div>

</body>
</html>
