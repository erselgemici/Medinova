@model List<Medinova.DTOs.ResultPackageDto>

@{
    ViewBag.Title = "Paket Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-xl bg-cyan-50 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-3xl">inventory_2</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Sağlık Paketleri</h1>
                <p class="text-slate-500 text-sm font-medium">Check-up ve özel tarama paketlerinin özellikleri.</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <a href="@Url.Action("Create", "AdminPackage")" class="relative group overflow-hidden px-8 py-3 rounded-xl bg-gradient-to-r from-primary to-cyan-500 text-white font-bold shadow-lg shadow-cyan-500/30 hover:shadow-cyan-500/50 transition-all duration-300 transform hover:-translate-y-0.5">
                <span class="absolute inset-0 w-full h-full bg-white/20 group-hover:translate-x-full transition-transform duration-500 ease-out -skew-x-12 origin-left"></span>
                <div class="relative flex items-center gap-2">
                    <span class="material-symbols-outlined">add_circle</span>
                    <span>Yeni Paket</span>
                </div>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-xl shadow-slate-200/40 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100">
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-24">ID</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-1/5">Paket Adı</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Fiyat / Dönem</th>
                        <th class="px-6 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Özellikler (Features)</th>
                        <th class="px-8 py-5 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest text-right w-40">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="group hover:bg-cyan-50/40 transition-all duration-300">

                                <td class="px-8 py-6 align-top">
                                    <span class="inline-flex items-center justify-center h-8 px-3 rounded-lg bg-slate-100 text-slate-500 text-xs font-bold font-mono">
                                        #@item.PackageID
                                    </span>
                                </td>

                                <td class="px-6 py-6 align-top">
                                    <span class="text-base font-bold text-slate-700 group-hover:text-primary transition-colors block">
                                        @item.PackageName
                                    </span>
                                </td>

                                <td class="px-6 py-6 align-top">
                                    <div class="flex flex-col gap-1">
                                        <span class="text-lg font-black text-green-600">@item.Price</span>
                                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">@item.Period</span>
                                    </div>
                                </td>

                                <td class="px-6 py-6 align-top">
                                    <ul class="space-y-1">
                                        @if (!string.IsNullOrEmpty(item.Feature1))
                                        {
                                            <li class="text-xs text-slate-600 flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>@item.Feature1</li>
}
                                        @if (!string.IsNullOrEmpty(item.Feature2))
                                        {
                                            <li class="text-xs text-slate-600 flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>@item.Feature2</li>
}
                                        @if (!string.IsNullOrEmpty(item.Feature3))
                                        {
                                            <li class="text-xs text-slate-600 flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>@item.Feature3</li>
}
                                        @if (!string.IsNullOrEmpty(item.Feature4))
                                        {
                                            <li class="text-xs text-slate-600 flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>@item.Feature4</li>
}
                                    </ul>
                                </td>

                                <td class="px-8 py-6 align-top text-right">
                                    <div class="flex items-center justify-end gap-3 opacity-80 group-hover:opacity-100 transition-opacity">
                                        <a href="@Url.Action("Update", "AdminPackage", new { id = item.PackageID })"
                                           class="h-10 w-10 rounded-xl bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-primary hover:text-white hover:border-primary shadow-sm hover:shadow-primary/30 transition-all duration-200">
                                            <span class="material-symbols-outlined text-[20px]">edit_square</span>
                                        </a>
                                        <a href="javascript:void(0);"
                                           data-url="@Url.Action("Delete", "AdminPackage", new { id = item.PackageID })"
                                           class="btn-sil h-10 w-10 rounded-xl bg-white border border-slate-200 text-slate-500 flex items-center justify-center hover:bg-red-500 hover:text-white hover:border-red-500 shadow-sm hover:shadow-red-500/30 transition-all duration-200">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-16 text-center text-slate-400 font-medium">Kayıtlı paket bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
