@model Medinova.DTOs.DepartmentDtos.UpdateDepartmentDto
@{
    ViewBag.Title = "Bölüm Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-100 mt-6">

    <div class="flex items-center gap-3 mb-8 pb-4 border-b border-gray-100">
        <div class="h-10 w-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600">
            <span class="material-symbols-outlined text-xl">edit_document</span>
        </div>
        <div>
            <h2 class="text-lg font-bold text-secondary">Bölüm Bilgilerini Düzenle</h2>
            <p class="text-xs text-gray-400">Mevcut bölüm adını buradan güncelleyebilirsiniz.</p>
        </div>
    </div>

    @using (Html.BeginForm("Update", "AdminDepartment", FormMethod.Post))
    {
        @Html.HiddenFor(x => x.DepartmentId)

        <div class="flex flex-col gap-6">

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-gray-700 ml-1 uppercase tracking-wide">Bölüm Adı</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">ward</span>
                    @Html.TextBoxFor(x => x.Name, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none text-sm" })
                </div>
                @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-red-500 text-xs font-medium ml-1" })
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-6 border-t border-gray-100">
                <a href="/Admin/AdminDepartment/Index" class="px-6 py-2.5 rounded-lg border border-gray-200 text-gray-600 font-bold hover:bg-gray-50 hover:text-gray-800 transition-colors text-sm">
                    Vazgeç
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary text-white font-bold hover:bg-primary/90 transition-all shadow-lg shadow-primary/30 flex items-center gap-2 text-sm">
                    <span class="material-symbols-outlined text-sm">update</span>
                    Değişiklikleri Kaydet
                </button>
            </div>
        </div>
    }
</div>
