@model List<Medinova.Models.Appointment>

@{
    ViewBag.Title = "Randevularım";
    Layout = "~/Areas/Doctor/Views/Shared/_DoctorLayout.cshtml";

    // Tarih Formatı için yardımcı değişkenler
    var today = DateTime.Today;
}

<div class="space-y-6">

    <div class="bg-gradient-to-r from-cyan-500 to-blue-600 rounded-2xl p-8 text-white shadow-xl shadow-cyan-500/20 relative overflow-hidden">
        <div class="absolute right-0 top-0 h-full w-1/3 bg-white/10 skew-x-12 transform origin-bottom-right"></div>

        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <h2 class="text-3xl font-black tracking-tight">Hoş Geldiniz Hocam,</h2>
                <p class="text-cyan-100 font-medium mt-1">Bugün sizi bekleyen <strong class="text-white text-lg">@Model.Count</strong> hasta randevusu bulunuyor.</p>
            </div>

            <div class="flex items-center gap-3 bg-white/20 p-3 rounded-xl border border-white/10 backdrop-blur-sm">
                <div class="h-10 w-10 rounded-lg bg-white text-cyan-600 flex items-center justify-center">
                    <span class="material-symbols-outlined">calendar_today</span>
                </div>
                <div>
                    <p class="text-xs text-cyan-100 font-bold uppercase">Bugünün Tarihi</p>
                    <p class="text-lg font-bold">@DateTime.Now.ToString("dd MMMM yyyy")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-50 flex flex-col sm:flex-row justify-between items-center gap-4">
            <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-cyan-500">format_list_bulleted</span>
                Randevu Listesi
            </h3>

            <div class="relative w-full sm:w-64">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 material-symbols-outlined text-[20px]">search</span>
                <input type="text" placeholder="Hasta adı ara..." class="w-full bg-slate-50 border border-slate-200 rounded-lg py-2 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-all">
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100">
                        <th class="px-6 py-4 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest w-24">Saat</th>
                        <th class="px-6 py-4 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Hasta Bilgileri</th>
                        <th class="px-6 py-4 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">İletişim</th>
                        <th class="px-6 py-4 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Randevu Tarihi</th>
                        <th class="px-6 py-4 text-[11px] font-extrabold text-slate-400 uppercase tracking-widest text-right">Durum / İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            // Tarih kontrolü (Geçmiş randevuları soluk gösterelim)
                            bool isPast = item.AppointmentDate < today;
                            string rowClass = isPast ? "opacity-60 bg-slate-50 grayscale" : "hover:bg-cyan-50/30 transition-colors";

                            <tr class="@rowClass group">
                                <td class="px-6 py-4 align-top">
                                    <div class="flex items-center justify-center h-10 w-16 bg-slate-100 rounded-lg text-slate-600 font-bold text-sm border border-slate-200">
                                        @item.AppointmentTime
                                    </div>
                                </td>

                                <td class="px-6 py-4 align-top">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 rounded-full bg-gradient-to-br from-purple-100 to-purple-200 text-purple-600 flex items-center justify-center font-bold text-sm">
                                            @item.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold text-slate-700">@item.FullName</p>
                                            <p class="text-xs text-slate-400 font-medium">TC: ***</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4 align-top">
                                    <div class="flex flex-col gap-1">
                                        <div class="flex items-center gap-2 text-slate-600">
                                            <span class="material-symbols-outlined text-[16px] text-slate-400">call</span>
                                            <span class="text-sm font-semibold">@item.PhoneNumber</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <div class="flex items-center gap-2 text-slate-500">
                                                <span class="material-symbols-outlined text-[16px] text-slate-400">mail</span>
                                                <span class="text-xs">@item.Email</span>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td class="px-6 py-4 align-top">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-400">event</span>
                                        <span class="text-sm font-bold text-slate-600">
                                            @(((DateTime)item.AppointmentDate).ToString("dd MMMM yyyy"))
                                        </span>
                                    </div>
                                    @if (item.AppointmentDate == today)
                                    {
                                        <span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 text-[10px] font-bold rounded-full uppercase tracking-wide">Bugün</span>
                                    }
                                </td>

                                <td class="px-6 py-4 align-top text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="@Url.Action("DeleteAppointment", "Dashboard", new { area = "Doctor", id = item.AppointmentId })"
                                           class="btn-sil inline-flex items-center gap-2 px-3 py-2 bg-white border border-slate-200 rounded-lg text-slate-500 text-xs font-bold hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-all shadow-sm">
                                            <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                            Tamamla / Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center text-slate-400">
                                    <div class="h-16 w-16 bg-slate-50 rounded-full flex items-center justify-center mb-4">
                                        <span class="material-symbols-outlined text-3xl">event_busy</span>
                                    </div>
                                    <p class="text-lg font-bold text-slate-600">Henüz randevu yok.</p>
                                    <p class="text-sm">Şu an için planlanmış bir hasta randevunuz bulunmuyor.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
