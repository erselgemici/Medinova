@model Medinova.DTOs.PackageDtos.UpdatePackageDto
@{
    ViewBag.Title = "Paket Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-100 mt-6">
    <div class="flex items-center gap-3 mb-8 pb-4 border-b border-gray-100">
        <div class="h-10 w-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600">
            <span class="material-symbols-outlined text-xl">edit</span>
        </div>
        <div>
            <h2 class="text-lg font-bold text-secondary">Paketi Düzenle</h2>
            <p class="text-xs text-gray-400">Mevcut paket özelliklerini güncelleyin.</p>
        </div>
    </div>

    @using (Html.BeginForm("Update", "AdminPackage", FormMethod.Post))
    {
        @Html.HiddenFor(x => x.PackageID)

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="flex flex-col gap-2 md:col-span-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Paket Adı</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">inventory_2</span>
                    @Html.TextBoxFor(x => x.PackageName, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Fiyat</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">payments</span>
                    @Html.TextBoxFor(x => x.Price, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Dönem</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">schedule</span>
                    @Html.TextBoxFor(x => x.Period, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="md:col-span-2 mt-4">
                <h3 class="text-sm font-bold text-slate-800 border-b border-gray-100 pb-2">Paket İçeriği (Features)</h3>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-500 ml-1">Özellik 1</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">check_circle</span>
                    @Html.TextBoxFor(x => x.Feature1, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-500 ml-1">Özellik 2</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">check_circle</span>
                    @Html.TextBoxFor(x => x.Feature2, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-500 ml-1">Özellik 3</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">check_circle</span>
                    @Html.TextBoxFor(x => x.Feature3, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-500 ml-1">Özellik 4</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">check_circle</span>
                    @Html.TextBoxFor(x => x.Feature4, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-6 border-t border-gray-100 md:col-span-2">
                <a href="/Admin/AdminPackage/Index" class="px-6 py-2.5 rounded-lg border border-gray-200 text-gray-600 font-bold hover:bg-gray-50 text-sm">Vazgeç</a>
                <button type="submit" class="px-8 py-2.5 rounded-lg bg-primary text-white font-bold hover:bg-primary/90 shadow-lg shadow-primary/30 flex items-center gap-2 text-sm">
                    <span class="material-symbols-outlined text-sm">update</span> Değişiklikleri Kaydet
                </button>
            </div>
        </div>
    }
</div>
