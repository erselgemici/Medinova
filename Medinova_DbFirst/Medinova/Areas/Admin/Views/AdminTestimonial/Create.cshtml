@model Medinova.DTOs.TestimonialDtos.CreateTestimonialDto
@{
    ViewBag.Title = "Yeni Yorum Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-100 mt-6">
    <div class="flex items-center gap-3 mb-8 pb-4 border-b border-gray-100">
        <div class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-xl">record_voice_over</span>
        </div>
        <div>
            <h2 class="text-lg font-bold text-secondary">Yeni Referans Ekle</h2>
            <p class="text-xs text-gray-400">Hasta yorumu ve görüşü oluşturun.</p>
        </div>
    </div>

    @using (Html.BeginForm("Create", "AdminTestimonial", FormMethod.Post))
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Ad Soyad</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">badge</span>
                    @Html.TextBoxFor(x => x.Name, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm", placeholder = "Örn: Ayşe Demir" })
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Meslek / Unvan</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">work</span>
                    @Html.TextBoxFor(x => x.Profession, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm", placeholder = "Örn: Öğretmen, Mühendis" })
                </div>
            </div>

            <div class="flex flex-col gap-2 md:col-span-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Profil Fotoğrafı (URL)</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 material-symbols-outlined text-[20px]">image</span>
                    @Html.TextBoxFor(x => x.ImageUrl, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none text-sm" })
                </div>
            </div>

            <div class="flex flex-col gap-2 md:col-span-2">
                <label class="text-xs font-bold text-slate-700 ml-1 uppercase">Hasta Yorumu</label>
                <div class="relative">
                    <span class="absolute left-3 top-4 text-gray-400 material-symbols-outlined text-[20px]">format_quote</span>
                    @Html.TextAreaFor(x => x.Description, new { @class = "w-full border border-gray-200 bg-gray-50 rounded-lg py-3 pl-10 pr-4 h-32 focus:bg-white focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none resize-none text-sm", placeholder = "Hastanın deneyim ve görüşleri..." })
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-6 border-t border-gray-100 md:col-span-2">
                <a href="/Admin/AdminTestimonial/Index" class="px-6 py-2.5 rounded-lg border border-gray-200 text-gray-600 font-bold hover:bg-gray-50 text-sm">Vazgeç</a>
                <button type="submit" class="px-8 py-2.5 rounded-lg bg-primary text-white font-bold hover:bg-primary/90 shadow-lg shadow-primary/30 flex items-center gap-2 text-sm">
                    <span class="material-symbols-outlined text-sm">save</span> Kaydet
                </button>
            </div>
        </div>
    }
</div>
