@model Medinova.Models.Doctor
@{
    ViewBag.Title = "Profil Bilgilerim";
    Layout = "~/Areas/Doctor/Views/Shared/_DoctorLayout.cshtml";
}

<div class="max-w-5xl mx-auto">

    @if (ViewBag.Success != null)
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-700 px-6 py-4 rounded-xl mb-8 shadow-sm animate-pulse">
            <span class="material-symbols-outlined">check_circle</span>
            <span class="font-bold">@ViewBag.Success</span>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">

        <div class="p-8 border-b border-slate-50 flex items-center justify-between bg-slate-50/30">
            <div>
                <h2 class="text-2xl font-black text-slate-800 tracking-tight">Kişisel Bilgiler</h2>
                <p class="text-sm text-slate-400 font-medium mt-1">Web sitesinde hastaların gördüğü profil kartınız.</p>
            </div>
            <div class="h-12 w-12 bg-blue-50 rounded-xl flex items-center justify-center text-[#13b6ec]">
                <span class="material-symbols-outlined text-3xl">badge</span>
            </div>
        </div>

        @using (Html.BeginForm("Index", "Profile", FormMethod.Post, new { @class = "p-8" }))
        {
            @Html.HiddenFor(x => x.DoctorId)

            <div class="flex flex-col lg:flex-row gap-10">

                <div class="flex-shrink-0 flex flex-col items-center gap-4 lg:w-64">
                    <div class="relative group">
                        <div class="w-48 h-48 rounded-full bg-slate-100 border-4 border-white shadow-xl overflow-hidden relative">
                            <img src="@Model.ImageUrl"
                                 alt="Doktor Profil"
                                 class="w-full h-full object-cover"
                                 onerror="this.src='https://via.placeholder.com/200?text=IMG'" />
                        </div>

                        <div class="absolute bottom-2 right-4 h-10 w-10 bg-[#13b6ec] rounded-full flex items-center justify-center text-white shadow-lg border-2 border-white">
                            <span class="material-symbols-outlined text-sm">photo_camera</span>
                        </div>
                    </div>

                    <div class="text-center px-4">
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-wider mb-1">Görünüm</p>
                        <p class="text-xs text-slate-500 leading-relaxed">Profil fotoğrafınızın net ve güven veren bir vesikalık olması önerilir.</p>
                    </div>
                </div>

                <div class="flex-1 space-y-6">

                    <div class="group">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 ml-1">Ad Soyad & Unvan</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-[#13b6ec] transition-colors material-symbols-outlined">id_card</span>
                            @Html.TextBoxFor(x => x.FullName, new { @class = "w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-12 pr-4 font-semibold text-slate-700 focus:bg-white focus:ring-2 focus:ring-[#13b6ec]/20 focus:border-[#13b6ec] outline-none transition-all" })
                        </div>
                    </div>

                    <div class="group">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 ml-1">Profil Fotoğrafı URL</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-[#13b6ec] transition-colors material-symbols-outlined">link</span>
                            @Html.TextBoxFor(x => x.ImageUrl, new { @class = "w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-12 pr-4 text-sm font-medium text-slate-600 focus:bg-white focus:ring-2 focus:ring-[#13b6ec]/20 focus:border-[#13b6ec] outline-none transition-all" })
                        </div>
                    </div>

                    <div class="group opacity-70">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 ml-1">Bağlı Olduğunuz Bölüm <span class="text-red-400 text-[10px] lowercase">(değiştirilemez)</span></label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 material-symbols-outlined">ward</span>
                            <input type="text" value="@(Model.Department != null ? Model.Department.Name : "Atanmamış")" disabled class="w-full bg-slate-100 border border-slate-200 rounded-xl py-3.5 pl-12 pr-4 font-bold text-slate-500 cursor-not-allowed select-none" />
                        </div>
                    </div>

                    <div class="group">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 ml-1">Hekim Biyografisi</label>
                        <div class="relative">
                            <span class="absolute left-4 top-5 text-slate-400 group-focus-within:text-[#13b6ec] transition-colors material-symbols-outlined">history_edu</span>
                            @Html.TextAreaFor(x => x.Description, new { @class = "w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-12 pr-4 text-sm font-medium text-slate-600 focus:bg-white focus:ring-2 focus:ring-[#13b6ec]/20 focus:border-[#13b6ec] outline-none transition-all h-32 resize-none leading-relaxed" })
                        </div>
                        <p class="text-[11px] text-slate-400 mt-2 text-right">Bu yazı randevu sayfasında hastalar tarafından görülecektir.</p>
                    </div>

                </div>
            </div>

            <div class="pt-8 mt-4 border-t border-slate-50 flex justify-end">
                <button type="submit" class="bg-[#13b6ec] hover:bg-[#0fa4d6] text-white font-bold py-3.5 px-8 rounded-xl transition-all shadow-lg shadow-cyan-500/20 flex items-center gap-3 transform active:scale-95">
                    <span class="material-symbols-outlined">save_as</span>
                    Değişiklikleri Kaydet
                </button>
            </div>
        }
    </div>
</div>
