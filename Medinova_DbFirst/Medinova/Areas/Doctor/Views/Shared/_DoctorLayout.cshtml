@{
    string doctorName = Session["UserInfo"] as string ?? "Sayın Doktor";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Doktor Paneli</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        .nav-link:hover {
            background-color: rgba(255,255,255,0.1);
        }

        .active-link {
            background-color: rgba(255,255,255,0.15);
            border-left: 4px solid #13b6ec;
        }
    </style>
</head>
<body class="antialiased text-slate-600">

    <div class="flex h-screen overflow-hidden">

        <aside class="w-64 bg-[#0f172a] text-white flex flex-col shadow-2xl z-20 transition-all duration-300">
            <div class="h-20 flex items-center gap-3 px-6 border-b border-white/10">
                <div class="h-10 w-10 bg-[#13b6ec] rounded-xl flex items-center justify-center shadow-lg shadow-cyan-500/20">
                    <span class="material-symbols-outlined text-white text-2xl">stethoscope</span>
                </div>
                <div>
                    <h1 class="text-xl font-black tracking-tight">Medinova</h1>
                    <p class="text-[10px] text-gray-400 font-medium uppercase tracking-widest">Doktor Paneli</p>
                </div>
            </div>

            <nav class="flex-1 flex flex-col gap-1 px-3 py-6 overflow-y-auto">

                <p class="px-4 text-[10px] text-gray-500 uppercase font-bold tracking-wider mb-2">Genel</p>

                <a class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-gray-300 hover:text-white nav-link"
                   href="@Url.Action("Index", "Dashboard", new { area = "Doctor" })">
                    <span class="material-symbols-outlined">calendar_month</span>
                    <span class="text-sm font-medium">Randevularım</span>
                </a>

                <a class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-gray-300 hover:text-white nav-link"
                   href="@Url.Action("Index", "Profile", new { area = "Doctor" })">
                    <span class="material-symbols-outlined">badge</span>
                    <span class="text-sm font-medium">Profil Bilgilerim</span>
                </a>

                <a class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-gray-300 hover:text-white nav-link"
                   href="@Url.Action("Index", "Schedule", new { area = "Doctor" })">
                    <span class="material-symbols-outlined">schedule</span>
                    <span class="text-sm font-medium">Çalışma Saatleri</span>
                </a>

            </nav>

            <div class="p-4 border-t border-white/10">
                <a href="@Url.Action("Logout", "Login", new { area = "" })"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white transition-all duration-300 group">
                    <span class="material-symbols-outlined group-hover:-translate-x-1 transition-transform">logout</span>
                    <span class="text-sm font-bold">Güvenli Çıkış</span>
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col h-screen overflow-hidden relative">

            <header class="h-20 bg-white border-b border-slate-100 flex items-center justify-between px-8 shadow-sm z-10">
                <h2 class="text-xl font-bold text-slate-800">@ViewBag.Title</h2>

                <div class="flex items-center gap-6">
                    <button class="relative p-2 text-slate-400 hover:text-[#13b6ec] transition-colors">
                        <span class="material-symbols-outlined">notifications</span>
                        <span class="absolute top-1 right-1 h-2.5 w-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>

                    <div class="flex items-center gap-3 pl-6 border-l border-slate-100">
                        <div class="text-right hidden md:block">
                            <p class="text-sm font-bold text-slate-700">@doctorName</p>
                            <p class="text-xs text-slate-400">Uzman Doktor</p>
                        </div>
                        <div class="h-10 w-10 rounded-full bg-[#13b6ec]/10 flex items-center justify-center text-[#13b6ec] font-bold text-lg border border-[#13b6ec]/20">
                            @doctorName.Substring(0, 1)
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto bg-[#f8fafc] p-8">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sayfadaki tüm "btn-sil" sınıfına sahip elementleri bul
            const deleteButtons = document.querySelectorAll('.btn-sil');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault(); // Linke gitmeyi durdur

                    const url = this.getAttribute('href'); // Gidilecek adresi al

                    Swal.fire({
                        title: 'Emin misiniz?',
                        text: "Bu işlem geri alınamaz, randevu iptal edilecek!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#13b6ec', // Medinova Mavisi
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Evet, Sil / İptal Et',
                        cancelButtonText: 'Vazgeç',
                        background: '#fff',
                        borderRadius: '1rem',
                        customClass: {
                            popup: 'rounded-2xl shadow-xl'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Onaylanırsa adrese git
                            window.location.href = url;
                        }
                    });
                });
            });
        });
    </script>
</body>
</html>
</body>
</html>
