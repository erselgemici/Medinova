@model Medinova.DTOs.SettingsDtos.ResultSettingsDto
@{
    ViewBag.Title = "Site Ayarları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-xl bg-cyan-50 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-3xl">settings</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Genel Ayarlar</h1>
                <p class="text-slate-500 text-sm font-medium">Site kimliği, iletişim bilgileri ve sosyal medya bağlantıları.</p>
            </div>
        </div>

        @if (Model.SettingID > 0)
        {
            <a href="@Url.Action("Update", "AdminSettings", new { id = Model.SettingID })" class="bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-xl text-sm font-bold flex items-center gap-2 transition-all shadow-lg shadow-primary/30">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                Bilgileri Düzenle
            </a>
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:border-primary/20 transition-all">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-9xl text-primary">contact_phone</span>
            </div>

            <h3 class="text-lg font-bold text-slate-800 mb-6 border-b border-slate-100 pb-2">İletişim Bilgileri</h3>

            <div class="space-y-4">
                <div class="flex items-start gap-4">
                    <div class="h-10 w-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400">
                        <span class="material-symbols-outlined">call</span>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-bold uppercase">Telefon</p>
                        <p class="text-slate-700 font-semibold">@Model.PhoneNumber</p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="h-10 w-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400">
                        <span class="material-symbols-outlined">mail</span>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-bold uppercase">E-Posta</p>
                        <p class="text-slate-700 font-semibold">@Model.Email</p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="h-10 w-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400">
                        <span class="material-symbols-outlined">location_on</span>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 font-bold uppercase">Adres</p>
                        <p class="text-slate-700 font-semibold leading-relaxed">@Model.Address</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:border-purple-500/20 transition-all">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-9xl text-purple-500">info</span>
            </div>

            <h3 class="text-lg font-bold text-slate-800 mb-6 border-b border-slate-100 pb-2">Site Alt Bilgisi (Footer)</h3>
            <p class="text-slate-600 leading-relaxed font-medium italic">
                "@Model.FooterDescription"
            </p>
        </div>
    </div>
</div>
